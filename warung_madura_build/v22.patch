diff -ruN a/lib/money_math.dart b/lib/money_math.dart
--- a/lib/money_math.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/money_math.dart	2026-09-29 00:59:06.447561997 +0000
@@ -0,0 +1,69 @@
+class SaleMath {
+  const SaleMath._();
+
+  static int lineTotal({required int unitPrice, required int qty}) {
+    if (unitPrice < 0) {
+      throw ArgumentError.value(unitPrice, 'unitPrice', 'Tidak boleh negatif');
+    }
+    if (qty <= 0) {
+      throw ArgumentError.value(qty, 'qty', 'Harus lebih dari 0');
+    }
+    return unitPrice * qty;
+  }
+
+  static int quantityBase({required int factor, required int qty}) {
+    if (factor <= 0) {
+      throw ArgumentError.value(factor, 'factor', 'Harus lebih dari 0');
+    }
+    if (qty <= 0) {
+      throw ArgumentError.value(qty, 'qty', 'Harus lebih dari 0');
+    }
+    return factor * qty;
+  }
+
+  static int clampDebt({required int total, required int requestedDebt}) {
+    if (total < 0) {
+      throw ArgumentError.value(total, 'total', 'Tidak boleh negatif');
+    }
+    if (requestedDebt <= 0) return total;
+    if (requestedDebt >= total) return total;
+    return requestedDebt;
+  }
+
+  static int paidNow({required int total, required int debt}) {
+    if (total < 0 || debt < 0) {
+      throw ArgumentError('Total dan hutang tidak boleh negatif');
+    }
+    final safeDebt = debt > total ? total : debt;
+    return total - safeDebt;
+  }
+
+  static int weightedAverageCost({
+    required int oldQtyBase,
+    required int oldCostPerBase,
+    required int incomingQty,
+    required int incomingUnitCost,
+    required int incomingFactor,
+  }) {
+    if (oldQtyBase < 0 ||
+        oldCostPerBase < 0 ||
+        incomingQty <= 0 ||
+        incomingUnitCost < 0 ||
+        incomingFactor <= 0) {
+      throw ArgumentError('Nilai persediaan tidak valid');
+    }
+    final incomingQtyBase = incomingQty * incomingFactor;
+    final afterQty = oldQtyBase + incomingQtyBase;
+    if (afterQty == 0) return oldCostPerBase;
+    final inventoryValue =
+        oldQtyBase * oldCostPerBase + incomingQty * incomingUnitCost;
+    return _roundDiv(inventoryValue, afterQty);
+  }
+
+  static int _roundDiv(int numerator, int denominator) {
+    if (denominator <= 0) {
+      throw ArgumentError.value(denominator, 'denominator');
+    }
+    return (numerator + denominator ~/ 2) ~/ denominator;
+  }
+}
